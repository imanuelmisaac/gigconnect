
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Is the user an admin?
    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
        request.auth.uid == 'rJq93j6Mi5NuAPEPNDYpLtSgFfc2'
      );
    }

    // Helper: Is the user the owner of the document?
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Master Override for Admins
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Artists/DJs Collection
    match /artists/{artistId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(artistId);

      // Feature Requests sub-collection
      match /features/{senderId} {
        // Read: Target artist or the sender
        allow read: if isSignedIn() && (isOwner(artistId) || isOwner(senderId));
        
        // Create: Only the sender
        allow create: if isSignedIn() && isOwner(senderId);
        
        // Update: Both (Target accepts/rejects, Sender might update message)
        allow update: if isSignedIn() && (isOwner(artistId) || isOwner(senderId));
        
        // Delete: Both
        allow delete: if isSignedIn() && (isOwner(artistId) || isOwner(senderId));
      }
    }

    // Allow collection group queries for features (needed for "Sent Requests" tab)
    match /{path=**}/features/{senderId} {
      allow read, list: if isSignedIn() && isOwner(senderId);
    }

    // Gig Makers Collection
    match /gig-makers/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(userId);
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.gigMakerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.gigMakerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.gigMakerId == request.auth.uid || isAdmin());

      match /applications/{applicationId} {
        // Read: Artist who applied or the Gig Maker who owns the event
        allow read: if isSignedIn() && (
          isOwner(applicationId) || 
          isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.gigMakerId)
        );

        // Create: Artist can apply if event is Open and Payment is Complete
        allow create: if isSignedIn() && 
          isOwner(applicationId) && 
          request.resource.data.artistId == request.auth.uid &&
          get(/databases/$(database)/documents/events/$(eventId)).data.status == 'Open' &&
          get(/databases/$(database)/documents/events/$(eventId)).data.paymentStatus == 'Complete';

        // Update: Only the Gig Maker can update status (Artists cannot re-apply/edit)
        allow update: if isSignedIn() && (
          isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.gigMakerId)
        );
        
        // Delete: Gig Maker can delete, or Artist can delete ONLY if it's still 'pending'
        allow delete: if isSignedIn() && (
          (isOwner(applicationId) && resource.data.status == 'pending') || 
          isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.gigMakerId) ||
          isAdmin()
        );
      }
    }
    
    // Allow collection group queries for applications (needed for Artist Dashboard)
    match /{path=**}/applications/{applicationId} {
      allow read, list: if isSignedIn() && isOwner(applicationId);
    }
  }
}
