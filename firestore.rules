
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Is the user an admin?
    // Using a more robust check for the admin role
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'rJq93j6Mi5NuAPEPNDYpLtSgFfc2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    // Master Override for Admins
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Artists/DJs Collection
    match /artists/{artistId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == artistId;

      // Feature Requests sub-collection
      match /features/{requestId} {
        allow read: if isSignedIn() && (request.auth.uid == artistId || request.auth.uid == resource.data.senderId);
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
        allow update: if isSignedIn() && (request.auth.uid == artistId || request.auth.uid == resource.data.senderId);
        allow delete: if isSignedIn() && (request.auth.uid == artistId || request.auth.uid == resource.data.senderId);
      }
    }

    // Allow collection group queries for features
    match /{path=**}/features/{senderId} {
      allow read, list: if isSignedIn() && request.auth.uid == senderId;
    }

    // Gig Makers Collection
    match /gig-makers/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.gigMakerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.gigMakerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.gigMakerId == request.auth.uid || isAdmin());

      match /applications/{applicationId} {
        // Read: Artist who applied or the Gig Maker who owns the event
        allow read: if isSignedIn() && (
          request.auth.uid == applicationId || 
          (exists(/databases/$(database)/documents/events/$(eventId)) && 
           request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.gigMakerId)
        );

        // Create: Artist can apply if event is Open and Payment is not flagged as Incomplete
        // Enforcing that applicationId MUST be the user's UID to prevent duplicate apps
        allow create: if isSignedIn() && 
          applicationId == request.auth.uid && 
          request.resource.data.artistId == request.auth.uid &&
          exists(/databases/$(database)/documents/events/$(eventId));

        // Update: Only the Gig Maker can update status. Artists cannot edit applications once sent.
        allow update: if isSignedIn() && (
          exists(/databases/$(database)/documents/events/$(eventId)) &&
          request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.gigMakerId
        );
        
        // Delete: Gig Maker can delete, or Artist can delete ONLY if it's still 'pending'
        allow delete: if isSignedIn() && (
          (request.auth.uid == applicationId && resource.data.status == 'pending') || 
          (exists(/databases/$(database)/documents/events/$(eventId)) && 
           request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.gigMakerId) ||
          isAdmin()
        );
      }
    }
    
    // Allow collection group queries for applications
    match /{path=**}/applications/{applicationId} {
      allow read, list: if isSignedIn() && request.auth.uid == applicationId;
    }
  }
}
