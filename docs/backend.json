
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Information about a registered user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "role": {
          "type": "string",
          "enum": [
            "artist",
            "gig-maker"
          ],
          "description": "The professional role of the user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the account was created"
        }
      },
      "required": [
        "userId",
        "email",
        "role",
        "createdAt"
      ]
    },
    "Artist": {
      "title": "Artist",
      "description": "Detailed professional profile for an artist",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "artistName": {
          "type": "string"
        },
        "dob": {
          "type": "string",
          "format": "date"
        },
        "idNumber": {
          "type": "string"
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "location": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "bookingPrice": {
          "type": "number"
        },
        "featurePrice": {
          "type": "number"
        },
        "whatsappNumber": {
          "type": "string"
        },
        "songLinks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "videoLink": {
          "type": "string"
        },
        "idFrontUrl": {
          "type": "string"
        },
        "idBackUrl": {
          "type": "string"
        },
        "profilePictureUrl": {
          "type": "string"
        },
        "profileComplete": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "fullName",
        "artistName",
        "profileComplete"
      ]
    },
    "GigMaker": {
      "title": "Gig Maker",
      "description": "Profile for business entities hiring talent",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "businessName": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "Bar",
            "Event Organizer"
          ]
        },
        "location": {
          "type": "string"
        },
        "whatsappNumber": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "businessName",
        "role",
        "location",
        "whatsappNumber"
      ]
    },
    "Event": {
      "title": "Event",
      "description": "A musical event created by a Gig Maker",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "gigMakerId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "applicationDeadline": {
          "type": "string",
          "format": "date"
        },
        "maxApplicants": {
          "type": "number"
        },
        "location": {
          "type": "string"
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minPrice": {
          "type": "number"
        },
        "maxPrice": {
          "type": "number"
        },
        "experienceLevel": {
          "type": "string",
          "enum": [
            "Upcoming",
            "Established"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "Open",
            "Closed",
            "Completed"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "eventId",
        "gigMakerId",
        "title",
        "date",
        "status",
        "location",
        "genres",
        "minPrice",
        "maxPrice",
        "experienceLevel"
      ]
    },
    "Application": {
      "title": "Application",
      "description": "An artist's application for an event",
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string"
        },
        "eventId": {
          "type": "string"
        },
        "artistId": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "message": {
          "type": "string"
        },
        "songLinks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "videoLink": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "Reviewed",
            "Accepted",
            "Rejected"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "applicationId",
        "eventId",
        "artistId",
        "status",
        "price"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents stored by Auth UID"
    },
    "/artists/{userId}": {
      "schema": "Artist",
      "description": "Detailed artist profile data"
    },
    "/gig-makers/{userId}": {
      "schema": "GigMaker",
      "description": "Gig maker business profile data"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Musical event listings"
    },
    "/events/{eventId}/applications/{applicationId}": {
      "schema": "Application",
      "description": "Applications from artists to a specific event"
    }
  }
}
